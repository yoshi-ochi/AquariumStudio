{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dev-offline",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.VITE_SUPABASE_URL='';process.env.VITE_SUPABASE_ANON_KEY='';import('vite').then(async v=>{const s=await v.createServer({server:{port:5174,strictPort:true}});await s.listen()})"
      ],
      "port": 5174
    },
    {
      "name": "dev-offline-alt",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.VITE_SUPABASE_URL='';process.env.VITE_SUPABASE_ANON_KEY='';import('vite').then(async v=>{const s=await v.createServer({server:{port:5176,strictPort:true}});await s.listen()})"
      ],
      "port": 5176
    },
    {
